{
  "$description": "Charte Bellajour V2. LA source unique : toute valeur de style vient d'ici. Format W3C Design Tokens (DTCG). Une valeur propre au téléphone est dans $extensions.bellajour.telephone (≤ 700 px). Ne rien modifier ailleurs : changer ici, puis `node brand/scripts/build-tokens.mjs`.",
  "$extensions": {
    "bellajour": {
      "version": "2.0.0",
      "date": "2026-11-25",
      "source": "Banc d'essai RKkzi v7, charte « Blanc pur · Fraunces », plus les variations du catalogue DEZh",
      "prefixe-css": "--m-"
    }
  },

  "couleur": {
    "$type": "color",
    "papier": {
      "$description": "La surface par défaut : un seul mode, pas de jour/nuit.",
      "fond": { "$value": "#ffffff" },
      "texte": { "$value": "#111111" },
      "texte-doux": { "$value": "#626262", "$description": "Encre à 66 % sur papier (banc : --sub)." },
      "ligne": { "$value": "#dedede", "$description": "Encre à 14 % (banc : --ligne)." },
      "pointille": { "$value": "#bcbcbc", "$description": "Encre à 28 %, cadres en attente." },
      "survol": { "$value": "#f3f3f3", "$description": "Encre à 5 %, survol du second bouton." },
      "champ-fond": { "$value": "#fafafa", "$description": "Encre à 2 %." },
      "champ-bord": { "$value": "#8f8f8f", "$description": "Encre à 48 %. Le banc avait 18 % (#d4d4d4), sous le seuil WCAG de 3:1 pour le bord d'un champ : relevé le 25/11, à valider en phase 2." },
      "filigrane": { "$value": "#eeeeee", "$description": "Encre à 7 % : le grand mot Bellajour du pied." }
    },
    "nuit": {
      "$description": "Bloc sombre inversé, en accent ponctuel (bandeau, carte cadeau, Noël). Ce n'est pas un mode.",
      "fond": { "$value": "#0c0c0d" },
      "texte": { "$value": "#f4f4f2" },
      "texte-doux": { "$value": "#a5a5a4" },
      "ligne": { "$value": "#2c2c2d" },
      "pointille": { "$value": "#4d4d4d" },
      "survol": { "$value": "#181818" },
      "champ-fond": { "$value": "#111112" },
      "champ-bord": { "$value": "#646464" },
      "filigrane": { "$value": "#1c1c1d" }
    },
    "accent": {
      "$value": "{couleur.papier.texte}",
      "$description": "TRANCHÉ 25/11 : l'accent est l'encre. Aucun bleu. Sur un bloc nuit, l'accent devient {couleur.nuit.texte}."
    },
    "etat": {
      "$description": "Texte d'état, toujours sur papier. Proposés le 25/11, à valider en phase 2.",
      "succes": { "$value": "#1f7a4d" },
      "erreur": { "$value": "#b42318" },
      "alerte": { "$value": "#8a5a00" },
      "info": { "$value": "{couleur.papier.texte}" },
      "pastille": { "$value": "#2f9e6b", "$description": "Le point vert « privé / validé » du banc. Jamais pour du texte (3,4:1)." }
    },
    "voile": {
      "$description": "Fonds translucides.",
      "barre": { "$value": "rgba(255, 255, 255, 0.9)", "$description": "En-tête une fois la page défilée, avec flou {flou.barre}." },
      "feuille": { "$value": "rgba(17, 17, 17, 0.3)", "$description": "Derrière une feuille ou une fenêtre, avec flou {flou.feuille}." },
      "photo-haut": { "$value": "rgba(0, 0, 0, 0.72)", "$description": "Dégradé de lecture sur photo, départ." },
      "photo-bas": { "$value": "rgba(0, 0, 0, 0.1)", "$description": "Dégradé de lecture sur photo, arrivée." }
    }
  },

  "police": {
    "titre": {
      "famille": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"] },
      "graisse": { "$type": "fontWeight", "$value": 560 },
      "graisse-gras": { "$type": "fontWeight", "$value": 720, "$description": "Le bouton « Gras » du banc." },
      "axes": { "$type": "string", "$value": "\"SOFT\" 40, \"WONK\" 0, \"opsz\" 96" },
      "approche": { "$type": "dimension", "$value": "-0.018em" },
      "interligne": { "$type": "number", "$value": 1.02 },
      "facteur": { "$type": "number", "$value": 0.9, "$description": "Multiplie h1, h2 et h3 (banc : --tsc). Pas les exceptions." }
    },
    "signature": {
      "$description": "Interlope : une phrase SEULE à l'écran, une fois par écran, jamais sous 40 px, jamais pour un titre de section, un prix, un bouton ou une étiquette.",
      "famille": { "$type": "fontFamily", "$value": ["Interlope", "cursive"] },
      "graisse": { "$type": "fontWeight", "$value": 400 },
      "approche": { "$type": "dimension", "$value": "0em" },
      "interligne": { "$type": "number", "$value": 1.12 },
      "taille-mini": { "$type": "dimension", "$value": "40px" },
      "trait-gras": { "$type": "dimension", "$value": "0.045em", "$description": "Contour qui épaissit Interlope en mode gras (paint-order: stroke fill)." }
    },
    "texte": {
      "famille": { "$type": "fontFamily", "$value": ["Inter Tight", "Helvetica Neue", "Arial", "sans-serif"] },
      "graisse": { "$type": "fontWeight", "$value": 400 },
      "graisse-moyenne": { "$type": "fontWeight", "$value": 500 }
    },
    "etiquette": {
      "$description": "TRANCHÉ 25/11 : Inter Tight. IBM Plex Mono sort de la charte.",
      "famille": { "$type": "fontFamily", "$value": "{police.texte.famille}" },
      "graisse": { "$type": "fontWeight", "$value": 500 },
      "approche": { "$type": "dimension", "$value": "0.12em" },
      "interligne": { "$type": "number", "$value": 1.3 },
      "casse": { "$type": "string", "$value": "uppercase" }
    },
    "magazine": {
      "$description": "Le titre imprimé SUR le magazine. Indépendant de la charte du site.",
      "famille": { "$type": "fontFamily", "$value": ["Instrument Serif", "Georgia", "serif"] },
      "graisse": { "$type": "fontWeight", "$value": 400 },
      "approche": { "$type": "dimension", "$value": "-0.02em" },
      "interligne": { "$type": "number", "$value": 0.95 }
    },
    "mail": {
      "$description": "Polices de secours des mails : les clients mail ne chargent pas les webfonts de façon fiable.",
      "titre": { "$type": "fontFamily", "$value": ["Georgia", "Times New Roman", "serif"] },
      "texte": { "$type": "fontFamily", "$value": ["Helvetica Neue", "Helvetica", "Arial", "sans-serif"] }
    }
  },

  "taille": {
    "$type": "dimension",
    "etiquette": { "$value": "12px" },
    "petit": { "$value": "14px" },
    "bouton": { "$value": "15px" },
    "base": { "$value": "clamp(16px, calc(15px + 0.25vw), 18px)" },
    "chapo": { "$value": "clamp(18px, calc(16px + 0.45vw), 22px)" },
    "h3": { "$value": "clamp(26px, calc(20px + 1.2vw), 36px)" },
    "h2": { "$value": "clamp(40px, calc(28px + 3vw), 76px)" },
    "h1": { "$value": "clamp(52px, calc(32px + 5vw), 116px)", "$extensions": { "bellajour": { "telephone": "44px" } } },
    "display": { "$value": "clamp(72px, calc(40px + 8vw), 168px)" },
    "champ": { "$value": "16px", "$description": "Jamais moins : sous 16 px, iOS zoome sur le champ." },
    "exception": {
      "$description": "Tailles hors échelle, figées et nommées (TRANCHÉ 25/11). Aucune autre valeur libre.",
      "signature-accueil": { "$value": "clamp(50px, 5.6vw, 98px)", "$extensions": { "bellajour": { "telephone": "40px" } } },
      "frise-mot": { "$value": "clamp(46px, 7.6vw, 124px)", "$extensions": { "bellajour": { "telephone": "42px" } } },
      "frise-tete": { "$value": "clamp(36px, 4.4vw, 66px)", "$extensions": { "bellajour": { "telephone": "30px" } } },
      "frise-nom": { "$value": "clamp(24px, 1.9vw, 30px)", "$extensions": { "bellajour": { "telephone": "24px" } } },
      "legende-livre": { "$value": "clamp(30px, 3.4vw, 48px)", "$extensions": { "bellajour": { "telephone": "26px" } } },
      "filigrane-pied": { "$value": "clamp(108px, 16vw, 196px)" },
      "signature-pied": { "$value": "clamp(24px, 2.2vw, 32px)" },
      "menu-lien": { "$value": "40px", "$extensions": { "bellajour": { "telephone": "36px" } } },
      "bandeau": { "$value": "13px" }
    }
  },

  "interligne": {
    "$type": "number",
    "texte": { "$value": 1.6 },
    "chapo": { "$value": 1.5 },
    "legal": { "$value": 1.7 },
    "signature-accueil": { "$value": 1.28 }
  },

  "mesure": {
    "$type": "dimension",
    "$description": "Longueur de ligne maximale.",
    "texte": { "$value": "60ch" },
    "chapo": { "$value": "44ch" },
    "legal": { "$value": "72ch" }
  },

  "espace": {
    "$type": "dimension",
    "$description": "Grille de 8 px (avec 4 et 12 pour les détails).",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" },
    "9": { "$value": "96px" },
    "10": { "$value": "128px" },
    "marge": { "$value": "clamp(20px, 5vw, 64px)", "$description": "La seule marge latérale de page (banc : --g)." },
    "section": { "$value": "clamp(96px, calc(72px + 6vw), 160px)", "$extensions": { "bellajour": { "telephone": "72px" } } },
    "tete-page": { "$value": "120px", "$description": "Haut d'une page intérieure, sous l'en-tête (+ bandeau).", "$extensions": { "bellajour": { "telephone": "96px" } } }
  },

  "largeur": {
    "$type": "dimension",
    "cadre": { "$value": "1280px", "$description": "Largeur maximale du contenu." },
    "colonne": { "$value": "760px", "$description": "Une colonne de lecture (récit, formulaire long)." },
    "boite": { "$value": "440px", "$description": "Feuille, fenêtre, petite carte." },
    "livre": { "$value": "min(92vw, 1100px, calc((100svh - 270px) * 1.414))", "$description": "Le magazine ouvert de l'accueil.", "$extensions": { "bellajour": { "telephone": "92vw" } } }
  },

  "rupture": {
    "$type": "dimension",
    "$description": "TRANCHÉ 25/11 : deux points de rupture seulement. CSS et JS lisent la même valeur (matchMedia).",
    "telephone": { "$value": "700px", "$description": "max-width: 700px = téléphone." },
    "large": { "$value": "901px", "$description": "min-width: 901px = menu complet dans l'en-tête ; en dessous, le menu burger." }
  },

  "rayon": {
    "$type": "dimension",
    "$description": "Cinq rayons (le banc en avait 15).",
    "pilule": { "$value": "999px", "$description": "Boutons, pastilles, puces." },
    "bloc": { "$value": "24px", "$description": "Feuilles, cartes, encarts." },
    "champ": { "$value": "14px" },
    "image": { "$value": "4px", "$description": "Photos et couvertures." },
    "rond": { "$value": "50%" }
  },

  "trait": {
    "$type": "dimension",
    "fin": { "$value": "1px", "$description": "Couleur {couleur.papier.ligne}." },
    "attente": { "$value": "1.5px", "$description": "Pointillé (dashed), couleur {couleur.papier.pointille} : un cadre à remplir." },
    "bouton-essai": { "$value": "1.5px" }
  },

  "ombre": {
    "$type": "shadow",
    "$description": "Trois ombres (le banc en avait 17). Seuls les objets imprimés portent une ombre ; l'interface n'en a pas.",
    "livre": { "$value": { "color": "rgba(0, 0, 0, 0.45)", "offsetX": "0px", "offsetY": "40px", "blur": "70px", "spread": "-35px" } },
    "objet": { "$value": { "color": "rgba(0, 0, 0, 0.45)", "offsetX": "0px", "offsetY": "26px", "blur": "40px", "spread": "-22px" } },
    "flottant": { "$value": { "color": "rgba(0, 0, 0, 0.45)", "offsetX": "0px", "offsetY": "14px", "blur": "24px", "spread": "-14px" } }
  },

  "flou": {
    "$type": "dimension",
    "barre": { "$value": "12px" },
    "feuille": { "$value": "6px" }
  },

  "focus": {
    "$description": "Anneau visible au clavier (:focus-visible) sur tout élément interactif. Proposé le 25/11.",
    "anneau-interieur": { "$type": "dimension", "$value": "3px", "$description": "Couleur du fond." },
    "anneau-exterieur": { "$type": "dimension", "$value": "5px", "$description": "Couleur {couleur.accent}." },
    "champ-anneau": { "$type": "dimension", "$value": "4px", "$description": "Champ actif : bord {couleur.accent} + halo d'encre à 14 %." }
  },

  "cible": {
    "$type": "dimension",
    "mini": { "$value": "44px", "$description": "Taille minimale de toute cible tactile." },
    "bouton": { "$value": "52px", "$extensions": { "bellajour": { "telephone": "44px" } } },
    "bouton-entete": { "$value": "44px" },
    "champ": { "$value": "54px" }
  },

  "bandeau": {
    "$type": "dimension",
    "hauteur": { "$value": "40px", "$extensions": { "bellajour": { "telephone": "36px" } } },
    "repli": { "$value": "12px", "$description": "Défilement après lequel le bandeau se replie." }
  },

  "plan": {
    "$type": "number",
    "$description": "Ordre d'empilement (z-index).",
    "contenu": { "$value": 1 },
    "entete": { "$value": 30 },
    "bandeau": { "$value": 31 },
    "menu": { "$value": 40 },
    "feuille": { "$value": 70 }
  },

  "duree": {
    "$type": "duration",
    "micro": { "$value": "200ms", "$description": "Appui, survol." },
    "standard": { "$value": "450ms", "$description": "Feuille qui monte, bandeau." },
    "menu": { "$value": "550ms" },
    "entree": { "$value": "900ms", "$description": "Apparition d'un bloc au défilement." },
    "decalage": { "$value": "80ms", "$description": "Entre deux éléments d'une même apparition." }
  },

  "courbe": {
    "$type": "cubicBezier",
    "sortie": { "$value": [0.2, 0.7, 0.2, 1], "$description": "La courbe de la maison : tout ce qui entre." },
    "bascule": { "$value": [0.7, 0, 0.2, 1], "$description": "Ce qui couvre l'écran : menu." }
  },

  "mouvement": {
    "entree-distance": { "$type": "dimension", "$value": "24px" },
    "appui-echelle": { "$type": "number", "$value": 0.97 },
    "defilement-lissage": { "$type": "number", "$value": 0.8, "$description": "scrub GSAP de l'ouverture du livre ; 0.7 pour la pile." },
    "suiveur-lissage": { "$type": "number", "$value": 0.22 }
  },

  "variation": {
    "$description": "Détails graphiques du catalogue DEZh : disponibles, DÉSACTIVÉS par défaut, jamais dans les mails pour l'instant (TRANCHÉ 25/11). On les active cas par cas.",
    "signatures-fond": {
      "$description": "Le logo vectoriel (brand/assets/logo/bellajour.svg) répété serré, en quinconce. Motif généré par build-tokens.mjs : public/images/v2/ui/motif-signatures.svg.",
      "actif": { "$type": "boolean", "$value": false },
      "opacite-page": { "$type": "number", "$value": 0.055 },
      "opacite-objet": { "$type": "number", "$value": 0.1 },
      "angle": { "$type": "string", "$value": "-12deg" },
      "logo-largeur": { "$type": "dimension", "$value": "96px" },
      "tuile-largeur": { "$type": "dimension", "$value": "108px", "$description": "Logo + 12 % d'écart : serré." },
      "tuile-hauteur": { "$type": "dimension", "$value": "91px", "$description": "Deux rangées, la seconde décalée d'une demi-tuile." }
    },
    "points-fins": {
      "actif": { "$type": "boolean", "$value": false },
      "tuile": { "$type": "dimension", "$value": "7px" },
      "rayon": { "$type": "dimension", "$value": "0.9px" },
      "opacite": { "$type": "number", "$value": 0.15 }
    },
    "pointille-frise": {
      "$description": "Le pointillé de la frise (actif sur l'accueil).",
      "actif": { "$type": "boolean", "$value": true },
      "point": { "$type": "dimension", "$value": "1.15px" },
      "pas": { "$type": "dimension", "$value": "8px" },
      "hauteur": { "$type": "dimension", "$value": "4px" },
      "repere": { "$type": "dimension", "$value": "11px", "$description": "Point de date, halo de 3 px couleur du fond." }
    },
    "signature-pied": {
      "$description": "Le logo vectoriel, incliné, en bas de page.",
      "actif": { "$type": "boolean", "$value": false },
      "largeur": { "$type": "dimension", "$value": "118px" },
      "hauteur": { "$type": "dimension", "$value": "45px", "$description": "Proportion du logo vectoriel." },
      "angle": { "$type": "string", "$value": "-5deg" }
    },
    "grain": {
      "actif": { "$type": "boolean", "$value": false },
      "frequence": { "$type": "number", "$value": 0.9 },
      "octaves": { "$type": "number", "$value": 2 },
      "opacite": { "$type": "number", "$value": 0.055 },
      "tuile": { "$type": "dimension", "$value": "180px" }
    }
  },

  "mail": {
    "largeur": { "$type": "dimension", "$value": "600px" },
    "marge": { "$type": "dimension", "$value": "24px" },
    "rayon-bouton": { "$type": "dimension", "$value": "{rayon.pilule}" }
  }
}
