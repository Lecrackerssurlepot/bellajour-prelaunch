BREVO_API_KEY=
BREVO_WAITLIST_LIST_ID=
BREVO_TEMPLATE_W1_ID=5
BREVO_TEMPLATE_P1_ID=10
BREVO_TEMPLATE_P2_ID=11
NEXT_PUBLIC_SITE_URL=

# Stripe Checkout — POST /api/checkout (acompte prévente)
STRIPE_SECRET_KEY=
# Codes influenceur valides (séparés par virgules). Vide → aucun code valide.
INFLUENCER_CODES=

# Cercle Ambassadeur — secret de signature des liens magiques (HMAC). Chaîne longue aléatoire.
AMBASSADEUR_LINK_SECRET=

# --- Templates Brevo transactionnels prévente (mapping dans CLAUDE.md) ---
# Sans ces IDs, sendBrevoEmail fait un skip SILENCIEUX : aucun mail, aucune erreur.
# À déclarer aussi dans Vercel > Settings > Environment Variables (Production).
BREVO_TEMPLATE_F1_ID=17        # Fondateur (webhook completed, offre founder)
BREVO_TEMPLATE_S1_ID=18        # Standard  (webhook completed, offre standard)
BREVO_TEMPLATE_P3_ID=19        # Parrain   (webhook completed si referred_by)
BREVO_TEMPLATE_A1_ID=20        # Ambassadeur bienvenue
BREVO_TEMPLATE_A2_ID=21        # Ambassadeur accès
BREVO_TEMPLATE_A3_ID=22        # Album offert au 6e parrainage
BREVO_TEMPLATE_RELANCE_ID=23   # Relance session.expired

# ════════════════════════════════════════════════════════════════
# Variables DÉJÀ UTILISÉES par le code mais qui manquaient ici.
# Sans elles, le projet ne démarre pas — un nouveau contributeur
# ne pouvait pas le deviner.
# ════════════════════════════════════════════════════════════════
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # service role — bypass RLS, strictement server-side
STRIPE_WEBHOOK_SECRET=         # vérification de signature de /api/webhook
ADMIN_PASSWORD=                # sert AUSSI de clé HMAC du cookie bj_admin :
                               # le changer invalide toutes les sessions /admin

# ════════════════════════════════════════════════════════════════
# L'ATELIER — stockage photos Cloudflare R2 (lot 4)
# La politique de confidentialité annonce déjà R2 (UE) en FR/EN/PT.
# ════════════════════════════════════════════════════════════════
R2_ENDPOINT=                   # https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRESIGNED_URL_TTL_SECONDS=3600   # le cache client rejette à 45 min (piège 5)
S3_FORCE_PATH_STYLE=false           # false pour R2, true seulement pour MinIO local

# ⚠️ NE PAS poser R2_PUBLIC_URL : elle rendrait TOUTES les lectures publiques
#    et permanentes. Les photos clientes ne sont jamais publiques (piège 26).
#
# ⚠️ La règle CORS du bucket n'est PAS dans ce dépôt — elle vit dans le
#    tableau de bord Cloudflare, et c'est elle seule qui autorise l'envoi.
#    AllowedOrigins doit lister bellajour.fr, www.bellajour.fr ET les URL de
#    preview Vercel : un environnement absent de cette liste rend tout envoi
#    impossible (incident déjà vécu). AllowedMethods = PUT, GET, HEAD.
#    AllowedHeaders doit contenir au minimum Content-Type — c'est le seul
#    en-tête posé par le navigateur, la signature voyageant dans l'URL.

# ════════════════════════════════════════════════════════════════
# L'ATELIER — paiement (lot 6)
# ════════════════════════════════════════════════════════════════
# Aucune nouvelle variable Stripe : /api/atelier/checkout réutilise
# STRIPE_SECRET_KEY, et /api/webhook (PARTAGÉ avec la prévente) réutilise
# STRIPE_WEBHOOK_SECRET. Le tri entre les deux produits se fait sur
# metadata.kind === "atelier", au switch, avant tout accès en base.
#
# Le prix ne vient PAS d'ici : il est calculé côté serveur depuis la colonne
# `palier` via src/lib/atelier/prix.ts (invariant nº2). Rien à poser.
#
# ⚠️ TVA — Stripe Tax est actif sur le compte (siège fiscal Lisboa, PT) mais
#    AUCUNE immatriculation n'y est déclarée. Tant que c'est le cas, Stripe
#    calcule 0 € de taxe sur chaque album. Le code est déjà câblé en TTC
#    (tax_behavior "inclusive") : le jour où l'immatriculation portugaise est
#    ajoutée dans le tableau de bord, le prix affiché ne bouge pas et la TVA
#    se découpe toute seule sur la facture. Rien à redéployer.
#
# ─────────────────────────── Atelier — mails (lot 8) ───────────────────────
# Templates Brevo créés le 24/08/2026, sur la charte SOMBRE de l'atelier.
# Variable absente = skip silencieux (aucun mail, aucune erreur, aucun verrou
# posé : le mail partira le jour où la variable arrive).
BREVO_WEBHOOK_SECRET=          # secret du webhook rebonds (en-tete x-bellajour-secret)
BREVO_TEMPLATE_M0_ID=38        # accusé, fin écran 4 → « {{titre}} est ouvert, il attend vos photos »
BREVO_TEMPLATE_M1_ID=27        # dépôt terminé      → « {{titre}}, c'est parti »
BREVO_TEMPLATE_M3_ID=28        # état 2, couverture → « {{titre}}, votre couverture »
BREVO_TEMPLATE_M4_ID=29        # paiement reçu      → « {{titre}}, nous composons »

# Secret de /api/atelier/mails/relever (la relève qui envoie M3).
# Passe en en-tête, JAMAIS dans l'URL. Absent = la route répond 404.
#   curl -X POST https://www.bellajour.fr/api/atelier/mails/relever \
#        -H "x-atelier-secret: $ATELIER_MAILS_SECRET"
ATELIER_MAILS_SECRET=

# ─────────────────────── Fermeture de la prévente ───────────────────────
# "true" = la caisse est close : /api/checkout répond 410 sans créer la
# moindre session Stripe, et /api/offer-state renvoie offerMode "closed"
# (la page /preventes affiche alors sa clôture au lieu des offres).
# Ne touche JAMAIS /api/webhook (les remboursements des 14 fondateurs
# passent par là), ni /merci, ni les pages légales, ni les crédits de
# parrainage. Rebasculer sur "false" rouvre tout en un redéploiement.
PREVENTE_FERMEE=

# ──────────────── Atelier — impression Cloudprinter (PRD §13 phase 2) ────────────────
# Clé de l'interface CloudCore API (dashboard Cloudprinter → CloudCore API
# Interfaces). Le mode Sandbox/Live est une propriété de l'INTERFACE au
# dashboard, pas d'une URL : sur la Preview Vercel, poser la clé d'une
# interface en mode SANDBOX (commandes gratuites, jamais imprimées, signaux
# simulés) ; en Production, celle de l'interface Live.
# ⚠️ Absente = MODE MANUEL : « Envoyer à l'impression » ne fait que changer
# l'état, la commande est à passer à la main chez l'imprimeur (comportement
# d'avant ce lot — rien ne casse).
CLOUDPRINTER_API_KEY=

# Clé de l'interface CloudSignal (dashboard → CloudSignal, l'endpoint à y
# déclarer est https://<domaine>/api/cloudprinter/webhook). Chaque signal
# porte cette clé dans son corps ; la route la vérifie à durée constante.
# Absente = la route répond 404 (fermée par défaut).
CLOUDPRINTER_WEBHOOK_KEY=

# ════════════════════════════════════════════════════════════════
# COMPLÉMENT DU 29/08/2026 (T-011) — douze variables lues par le code
# et qui ne figuraient nulle part ici.
#
# La règle de ce fichier : une variable absente de l'environnement ne
# fait JAMAIS d'erreur sur ce projet. Elle fait un SILENCE. C'est le
# mode de panne dominant, et cette liste est le seul endroit qui
# permette de le prévenir. Chaque entrée dit ce qui se tait sans elle.
# ════════════════════════════════════════════════════════════════

# ─────────────────── Comptes d'administration nominatifs ───────────────────
# Remplacent le mot de passe partagé ADMIN_PASSWORD (encore accepté sous le
# compte générique « atelier » — dette suivie en T-005). Chaque geste de
# l'atelier est attribué au compte connecté : notes.qui, numeros.en_charge,
# et le journal des évènements. Sans elles, plus personne n'entre.
# À poser sur Vercel en Production ET en Preview.
ADMIN_PASSWORD_MATHIAS=
ADMIN_PASSWORD_LOUIS=

# ─────────────────── Relève quotidienne (cron Vercel) ───────────────────
# Injecté automatiquement par Vercel quand un cron est déclaré dans
# vercel.json. Accepté par /api/atelier/mails/relever en second secret,
# via `Authorization: Bearer`, à côté de ATELIER_MAILS_SECRET.
# ⚠️ Sans la relève quotidienne (7 h UTC), M2, M3b, M8 et l'auto-validation
# à J+7 ne partent JAMAIS. Aucune alerte ne le signale.
CRON_SECRET=

# Borne de date de la relance M2, au format AAAA-MM-JJ. Seul M2 n'a pas de
# mail prédécesseur : cette date l'empêche de partir en masse sur les vieux
# dossiers le jour où on l'active. La reculer sur la Preview rend M2 testable.
ATELIER_M2_DEPUIS=

# ─────────────── Templates Brevo de l'atelier (M0 à M10) ───────────────
# M0, M1, M3 et M4 sont déjà déclarés plus haut. Voici les neuf autres.
# ⚠️ Si l'un manque, envoyerMailAtelier saute le mail SANS poser son verrou
# dans mails_envoyes : il sera sauté de nouveau à chaque relève, à l'infini,
# sans erreur. /admin/atelier/sante est le seul écran qui le montre.
# Le TEXTE de ces mails est versionné dans scripts/mails-atelier.mjs, pas
# dans l'interface Brevo. Pour en pousser un seul :
#   node scripts/mails-atelier.mjs --pousser --seulement M5
BREVO_TEMPLATE_M2_ID=      # « il manque les photos » — dossier vide, J+1
BREVO_TEMPLATE_M2B_ID=     # « dépôt resté en plan » — des photos, mais jamais envoyées
BREVO_TEMPLATE_M3B_ID=     # « votre numéro vous attend » — relance après la couverture
BREVO_TEMPLATE_M5_ID=      # la maquette complète
BREVO_TEMPLATE_M6_ID=      # départ à l'impression
BREVO_TEMPLATE_M7_ID=      # « votre numéro est en route » + encart de suivi
# Sans lui, le client n'est jamais prévenu que son colis est arrivé et ne
# reçoit pas son magazine numérique (le mail attend AUSSI que le PDF souvenir
# soit généré — carte Impression de la fiche admin).
BREVO_TEMPLATE_M7B_ID=     # livré — « votre magazine est arrivé » + lien du PDF souvenir
BREVO_TEMPLATE_M8_ID=      # livré + 3 jours — « le prochain moment ? »
BREVO_TEMPLATE_M9_ID=      # « quelques photos de plus ? »
# T-076 — le préavis de fermeture, à J-83 d'un dossier abandonné.
# ⚠️ CELUI-CI COMMANDE UNE SUPPRESSION DE DONNÉES. Tant qu'il manque, M10 ne
# part pas, donc `scripts/anonymiser-dossiers.ts` n'anonymise RIEN : il refuse
# de refermer un dossier qui n'a pas été prévenu. La rétention de 90 jours ne
# commence réellement à s'appliquer que le jour où cette variable existe.
BREVO_TEMPLATE_M10_ID=     # « votre numéro va se refermer » — préavis 90 jours

# ════════════════════════════════════════════════════════════════
# Le COMPTE CLIENTE (04/09) — Supabase Auth en « identité seulement ».
# Sans SUPABASE_ANON_KEY, la brique compte entière fait silence : le site
# vit comme avant (le token /numero reste l'identité). La clé anon reste
# SERVEUR (jamais NEXT_PUBLIC_*) : aucun client Supabase dans le
# navigateur, cookies de session httpOnly. RLS sans policy fait qu'elle
# ne peut lire aucune table — elle ne sert qu'à /auth/v1/*.
# ════════════════════════════════════════════════════════════════
# ⚠️ CES TROIS VARIABLES COMMANDENT L'OUVERTURE DE L'ESPACE COMPTE.
# En production, tant que les trois ne sont pas posées, `compteOuvert()`
# rend faux : pas d'entrée dans la barre, pas d'invitation sur la page du
# numéro, et /compte/* rend 404. Ce n'est pas de la prudence excessive —
# sans le template C1, une inscription créerait un compte dont le mail de
# confirmation ne partirait jamais. Les poser OUVRE la porte au public :
# activer le provider Google dans Supabase AVANT.
SUPABASE_ANON_KEY=             # clé « anon/publishable » du projet, côté serveur seulement
BREVO_TEMPLATE_C1_ID=          # compte — « votre espace vous attend » (confirmation d'inscription)
BREVO_TEMPLATE_C2_ID=          # compte — « un nouveau mot de passe » (réinitialisation)
